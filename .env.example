# Auth.js
AUTH_SECRET=replace-with-a-random-secret
AUTH_URL=http://localhost:3000

# Atlassian OAuth 2.0 (3LO)
AUTH_ATLASSIAN_ID=your-atlassian-client-id
AUTH_ATLASSIAN_SECRET=your-atlassian-client-secret

# Jira Cloud site that users must be able to access
ATLASSIAN_JIRA_CLOUD_URL=https://your-company.atlassian.net
